{
  "name": "@lowwattlabs/n8n-nodes-clamav",
  "version": "0.1.2",
  "description": "n8n community node for ClamAV antivirus scanning via clamd TCP socket (SCAN, INSTREAM, STATS, batch directory scan, real-time monitor)",
  "keywords": [
    "n8n-community-node-package",
    "clamav",
    "antivirus",
    "security",
    "clamd",
    "malware"
  ],
  "license": "MIT",
  "author": {
    "name": "LowWatt Labs",
    "email": "nodes@lowwattlabs.com"
  },
  "homepage": "https://lowwattlabs.com/clamav",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowwattlabs/n8n-nodes-clamav.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint nodes/ credentials/ --ext .ts"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ClamavApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Clamav/Clamav.node.js"
    ]
  },
  "files": [
    "dist/**/*"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "dist"
    ]
  }
}